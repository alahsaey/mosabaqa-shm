# Google Gemini API Key
# احصل على مفتاحك من https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Secret key used to sign WebAuthn challenges and server-verified admin session tokens
# مفتاح سري عشوائي طويل لتوقيع جلسات الإدارة وتحديات البصمة
SESSION_SECRET=

# Optional: Firebase Web API Key override for external hosts (e.g. Cloudflare Pages)
# اختياري: مفتاح Firebase Web API الصالح للاستضافات الخارجية (مثل Cloudflare Pages)
VITE_FIREBASE_API_KEY=

# Optional: Server-side Super Admin password override (username: alahsaey)
# اختياري: كلمة مرور بديلة لحساب الدعم الفني على الخادم
SUPER_ADMIN_PASSWORD=

